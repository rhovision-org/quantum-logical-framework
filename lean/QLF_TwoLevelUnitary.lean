import Mathlib

/-!
# QLF_TwoLevelUnitary — every unitary is a product of two-level unitaries

Stage 2 of Barenco et al. (1995), *Elementary gates for quantum computation*, Phys. Rev. A
**52**, 3457 (the decomposition is also Reck et al. 1994 and Nielsen–Chuang §4.5.1).

A unitary is **two-level** when it acts as the identity outside the span of two basis vectors
`eᵢ, eⱼ` (`TwoLevel`; `i = j` is allowed, which covers a single phase). The theorem:

* `unitary_mem_closure_twoLevel`: every unitary on a finite index type lies in the monoid
  generated by two-level unitaries, and `unitary_eq_prod_twoLevel` gives it as an explicit
  finite product.

The proof is Givens elimination. A two-level rotation on `(a, b)` sends the `b` entry of a
vector to zero (`givens_exists`). Clearing a column this way (`clear_column`) leaves a unitary
whose column `a` is `c·eₐ`; unitarity forces its row `a` to be `c̄⁻¹·eₐ` too
(`row_of_column`), a phase removes `c`, and the rest is a unitary on one fewer index
(induction on the support, `supported_mem_closure`).

No axioms beyond Lean's own. Part of the [Quantum Logical Framework (QLF)](../README.md);
write-up in [`Barenco_Universality.md`](../Barenco_Universality.md).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace QLF.TwoLevelUnitary

open Matrix

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- `U` acts as the identity outside the coordinates in `S`. -/
def SupportedOn (S : Finset ι) (U : Matrix ι ι ℂ) : Prop :=
  ∀ k l, (k ∉ S ∨ l ∉ S) → U k l = (1 : Matrix ι ι ℂ) k l

/-- A **two-level unitary**: unitary, and the identity outside two coordinates. -/
def TwoLevel (U : Matrix ι ι ℂ) : Prop :=
  U ∈ Matrix.unitaryGroup ι ℂ ∧ ∃ i j : ι, SupportedOn {i, j} U

/-- The monoid generated by the two-level unitaries. -/
def twoLevelClosure (ι : Type*) [Fintype ι] [DecidableEq ι] : Submonoid (Matrix ι ι ℂ) :=
  Submonoid.closure {U | TwoLevel U}

/-! ## Supports -/

theorem row_mul {S : Finset ι} {U : Matrix ι ι ℂ} (hU : SupportedOn S U) {k : ι} (hk : k ∉ S)
    (V : Matrix ι ι ℂ) (l : ι) : (U * V) k l = V k l := by
  have h : ∀ m, U k m = (1 : Matrix ι ι ℂ) k m := fun m => hU k m (Or.inl hk)
  rw [show (U * V) k l = ((1 : Matrix ι ι ℂ) * V) k l by simp only [mul_apply, h], one_mul]

theorem mul_col {S : Finset ι} {U : Matrix ι ι ℂ} (hU : SupportedOn S U) {l : ι} (hl : l ∉ S)
    (V : Matrix ι ι ℂ) (k : ι) : (V * U) k l = V k l := by
  have h : ∀ m, U m l = (1 : Matrix ι ι ℂ) m l := fun m => hU m l (Or.inr hl)
  rw [show (V * U) k l = (V * (1 : Matrix ι ι ℂ)) k l by simp only [mul_apply, h], mul_one]

theorem mulVec_out {S : Finset ι} {U : Matrix ι ι ℂ} (hU : SupportedOn S U) {k : ι} (hk : k ∉ S)
    (v : ι → ℂ) : (U *ᵥ v) k = v k := by
  have h : ∀ m, U k m = (1 : Matrix ι ι ℂ) k m := fun m => hU k m (Or.inl hk)
  rw [show (U *ᵥ v) k = ((1 : Matrix ι ι ℂ) *ᵥ v) k by simp only [mulVec, dotProduct, h],
    one_mulVec]

theorem SupportedOn.mul {S : Finset ι} {U V : Matrix ι ι ℂ} (hU : SupportedOn S U)
    (hV : SupportedOn S V) : SupportedOn S (U * V) := by
  intro k l h
  rcases h with hk | hl
  · rw [row_mul hU hk]; exact hV k l (Or.inl hk)
  · rw [mul_col hV hl]; exact hU k l (Or.inr hl)

theorem SupportedOn.mono {S T : Finset ι} {U : Matrix ι ι ℂ} (hU : SupportedOn S U)
    (hST : S ⊆ T) : SupportedOn T U := by
  intro k l h
  exact hU k l (h.imp (fun hk hk' => hk (hST hk')) (fun hl hl' => hl (hST hl')))

theorem SupportedOn.star {S : Finset ι} {U : Matrix ι ι ℂ} (hU : SupportedOn S U) :
    SupportedOn S (star U) := by
  intro k l h
  rw [Matrix.star_apply, hU l k h.symm, Matrix.one_apply, Matrix.one_apply]
  by_cases hkl : k = l
  · subst hkl; simp
  · simp [hkl, Ne.symm hkl]

theorem supportedOn_one (S : Finset ι) : SupportedOn S (1 : Matrix ι ι ℂ) := fun _ _ _ => rfl

theorem eq_one_of_supportedOn_empty {U : Matrix ι ι ℂ} (hU : SupportedOn ∅ U) : U = 1 := by
  ext k l; exact hU k l (Or.inl (Finset.notMem_empty k))

/-! ## The closure -/

theorem TwoLevel.star {U : Matrix ι ι ℂ} (h : TwoLevel U) : TwoLevel (star U) := by
  obtain ⟨hu, i, j, hs⟩ := h
  exact ⟨Unitary.star_mem hu, i, j, hs.star⟩

theorem closure_le_unitary : twoLevelClosure ι ≤ Matrix.unitaryGroup ι ℂ := by
  rw [twoLevelClosure, Submonoid.closure_le]
  intro U hU; exact hU.1

theorem mem_unitary_of_mem {U : Matrix ι ι ℂ} (h : U ∈ twoLevelClosure ι) :
    U ∈ Matrix.unitaryGroup ι ℂ := closure_le_unitary h

theorem star_mem_closure {U : Matrix ι ι ℂ} (h : U ∈ twoLevelClosure ι) :
    star U ∈ twoLevelClosure ι := by
  induction h using Submonoid.closure_induction with
  | mem x hx => exact Submonoid.subset_closure (TwoLevel.star hx)
  | one => rw [star_one]; exact Submonoid.one_mem _
  | mul x y _ _ hx hy => rw [star_mul]; exact Submonoid.mul_mem _ hy hx

theorem twoLevel_mem {U : Matrix ι ι ℂ} (h : TwoLevel U) : U ∈ twoLevelClosure ι :=
  Submonoid.subset_closure h

/-! ## Embedding a `2 × 2` matrix on two coordinates -/

/-- `V` placed on coordinates `a, b`, identity elsewhere. -/
def embed (a b : ι) (V : Matrix (Fin 2) (Fin 2) ℂ) : Matrix ι ι ℂ := fun k l =>
  if k = a then (if l = a then V 0 0 else if l = b then V 0 1 else 0)
  else if k = b then (if l = a then V 1 0 else if l = b then V 1 1 else 0)
  else (1 : Matrix ι ι ℂ) k l

theorem embed_supported (a b : ι) (V : Matrix (Fin 2) (Fin 2) ℂ) :
    SupportedOn {a, b} (embed a b V) := by
  intro k l h
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at h
  rcases h with ⟨hka, hkb⟩ | ⟨hla, hlb⟩
  · simp [embed, hka, hkb]
  · by_cases hka : k = a
    · subst hka; simp [embed, hla, hlb, Matrix.one_apply, Ne.symm hla]
    · by_cases hkb : k = b
      · subst hkb; simp [embed, hla, hlb, hka, Matrix.one_apply, Ne.symm hlb]
      · simp [embed, hka, hkb]

theorem embed_mul (a b : ι) (hab : a ≠ b) (V W : Matrix (Fin 2) (Fin 2) ℂ) :
    embed a b V * embed a b W = embed a b (V * W) := by
  have hV := embed_supported a b V
  have hW := embed_supported a b W
  have hVW := embed_supported a b (V * W)
  ext k l
  by_cases hk : k ∈ ({a, b} : Finset ι)
  · by_cases hl : l ∈ ({a, b} : Finset ι)
    · rw [mul_apply, Finset.sum_eq_add a b hab]
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hk hl
        rcases hk with rfl | rfl <;> rcases hl with rfl | rfl <;>
          simp [embed, hab, Ne.symm hab, Matrix.mul_apply, Fin.sum_univ_two]
      · intro c _ hc
        have : embed a b V k c = 0 := by
          rw [hV k c (Or.inr (by simp [hc.1, hc.2])), Matrix.one_apply]
          simp only [Finset.mem_insert, Finset.mem_singleton] at hk
          rcases hk with rfl | rfl
          · simp [Ne.symm hc.1]
          · simp [Ne.symm hc.2]
        rw [this, zero_mul]
      · simp
      · simp
    · rw [mul_col hW hl, hV k l (Or.inr hl), hVW k l (Or.inr hl)]
  · rw [row_mul hV hk, hW k l (Or.inl hk), hVW k l (Or.inl hk)]

theorem embed_one (a b : ι) (hab : a ≠ b) : embed a b 1 = 1 := by
  ext k l
  by_cases hka : k = a
  · subst hka; by_cases hla : l = k
    · subst hla; simp [embed]
    · by_cases hlb : l = b
      · subst hlb; simp [embed, hla, Matrix.one_apply, Ne.symm hla]
      · simp [embed, hla, hlb, Matrix.one_apply, Ne.symm hla]
  · by_cases hkb : k = b
    · subst hkb; by_cases hla : l = a
      · subst hla; simp [embed, hka, Matrix.one_apply, Ne.symm hka]
      · by_cases hlb : l = k
        · subst hlb; simp [embed, hla]
        · simp [embed, hka, hla, hlb, Matrix.one_apply, Ne.symm hlb]
    · simp [embed, hka, hkb]

theorem embed_star (a b : ι) (hab : a ≠ b) (V : Matrix (Fin 2) (Fin 2) ℂ) :
    star (embed a b V) = embed a b (star V) := by
  have h1 := (embed_supported a b V).star
  have h2 := embed_supported a b (star V)
  ext k l
  by_cases hk : k ∈ ({a, b} : Finset ι)
  · by_cases hl : l ∈ ({a, b} : Finset ι)
    · simp only [Finset.mem_insert, Finset.mem_singleton] at hk hl
      rcases hk with rfl | rfl <;> rcases hl with rfl | rfl <;>
        simp [embed, hab, Ne.symm hab, Matrix.star_apply]
    · rw [h1 k l (Or.inr hl), h2 k l (Or.inr hl)]
  · rw [h1 k l (Or.inl hk), h2 k l (Or.inl hk)]

theorem embed_twoLevel (a b : ι) (hab : a ≠ b) (V : Matrix (Fin 2) (Fin 2) ℂ)
    (hV : V ∈ Matrix.unitaryGroup (Fin 2) ℂ) : TwoLevel (embed a b V) := by
  refine ⟨?_, a, b, embed_supported a b V⟩
  rw [Matrix.mem_unitaryGroup_iff, embed_star a b hab, embed_mul a b hab,
    Matrix.mem_unitaryGroup_iff.mp hV, embed_one a b hab]

theorem embed_mulVec_b (a b : ι) (hab : a ≠ b) (V : Matrix (Fin 2) (Fin 2) ℂ) (v : ι → ℂ) :
    (embed a b V *ᵥ v) b = V 1 0 * v a + V 1 1 * v b := by
  rw [mulVec, dotProduct, Finset.sum_eq_add a b hab]
  · simp [embed, Ne.symm hab]
  · intro c _ hc; simp [embed, Ne.symm hab, hc.1, hc.2]
  · simp
  · simp

/-! ## Givens rotations -/

/-- **A Givens rotation.** For `a ≠ b` and any entries `x, y` there is a two-level unitary on
`a, b` sending every vector with `v a = x`, `v b = y` to one with `b` entry zero. -/
theorem givens_exists (a b : ι) (hab : a ≠ b) (x y : ℂ) :
    ∃ g : Matrix ι ι ℂ, TwoLevel g ∧ SupportedOn {a, b} g ∧
      ∀ v : ι → ℂ, v a = x → v b = y → (g *ᵥ v) b = 0 := by
  by_cases h0 : x = 0 ∧ y = 0
  · refine ⟨1, ⟨Submonoid.one_mem _, a, b, supportedOn_one _⟩, supportedOn_one _, ?_⟩
    intro v _ hb; rw [one_mulVec, hb, h0.2]
  · set s : ℝ := Complex.normSq x + Complex.normSq y with hs
    have hs0 : 0 < s := by
      rcases not_and_or.mp h0 with hx | hy
      · have := Complex.normSq_pos.mpr hx; have := Complex.normSq_nonneg y; linarith
      · have := Complex.normSq_pos.mpr hy; have := Complex.normSq_nonneg x; linarith
    set r : ℂ := ((Real.sqrt s : ℝ) : ℂ)
    have hr2 : r * r = (s : ℂ) := by
      simp only [r]; rw [← Complex.ofReal_mul, Real.mul_self_sqrt hs0.le]
    have hr0 : r ≠ 0 := by
      simp only [r]; exact_mod_cast (Real.sqrt_pos.mpr hs0).ne'
    have hrs : star r = r := by simp [r]
    let V : Matrix (Fin 2) (Fin 2) ℂ := r⁻¹ • !![star x, star y; -y, x]
    have hsc : ((Complex.normSq x : ℂ) + (Complex.normSq y : ℂ)) ≠ 0 := by
      rw [← Complex.ofReal_add, ← hs]; exact_mod_cast hs0.ne'
    have hMM : !![star x, star y; -y, x] * star !![star x, star y; -y, x]
        = ((Complex.normSq x : ℂ) + (Complex.normSq y : ℂ)) • (1 : Matrix (Fin 2) (Fin 2) ℂ) := by
      ext i j; fin_cases i <;> fin_cases j <;>
        simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.star_apply, Complex.mul_conj,
          Complex.conj_mul'] <;> ring_nf
    have hV : V ∈ Matrix.unitaryGroup (Fin 2) ℂ := by
      rw [Matrix.mem_unitaryGroup_iff]
      simp only [V, star_smul, smul_mul_smul_comm, hMM, smul_smul]
      rw [star_inv₀, hrs, ← mul_inv, hr2, hs, Complex.ofReal_add, inv_mul_cancel₀ hsc, one_smul]
    refine ⟨embed a b V, embed_twoLevel a b hab V hV, embed_supported a b V, ?_⟩
    intro v hva hvb
    rw [embed_mulVec_b a b hab, hva, hvb]
    simp [V]; ring

/-! ## Clearing a column -/

/-- **Column clearing.** A vector supported on `insert a T` is sent to a multiple of `eₐ` by a
product of two-level unitaries supported on `insert a T`. -/
theorem clear_column (a : ι) (T : Finset ι) (haT : a ∉ T) (v : ι → ℂ)
    (hv : ∀ k, k ∉ insert a T → v k = 0) :
    ∃ g ∈ twoLevelClosure ι, SupportedOn (insert a T) g ∧ ∃ c : ℂ, g *ᵥ v = Pi.single a c := by
  induction T using Finset.induction_on generalizing v with
  | empty =>
    refine ⟨1, Submonoid.one_mem _, supportedOn_one _, v a, ?_⟩
    rw [one_mulVec]; ext k
    by_cases hk : k = a
    · subst hk; simp
    · rw [Pi.single_apply, if_neg hk]; exact hv k (by simp [hk])
  | @insert b T' hbT' ih =>
    have hab : a ≠ b := fun h => haT (by simp [h])
    have haT' : a ∉ T' := fun h => haT (by simp [h])
    obtain ⟨G, hG, hGs, hGv⟩ := givens_exists a b hab (v a) (v b)
    have hw : ∀ k, k ∉ insert a T' → (G *ᵥ v) k = 0 := by
      intro k hk
      by_cases hkb : k = b
      · subst hkb; exact hGv v rfl rfl
      · have hk' : k ∉ ({a, b} : Finset ι) := by
          simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hk ⊢
          exact ⟨hk.1, hkb⟩
        rw [mulVec_out hGs hk']
        apply hv k
        simp only [Finset.mem_insert, not_or] at hk ⊢
        exact ⟨hk.1, hkb, hk.2⟩
    obtain ⟨g', hg', hg's, c, hc⟩ := ih haT' (G *ᵥ v) hw
    refine ⟨g' * G, Submonoid.mul_mem _ hg' (twoLevel_mem hG), ?_, c, ?_⟩
    · refine (hg's.mono ?_).mul (hGs.mono ?_)
      · intro k hk; simp only [Finset.mem_insert] at hk ⊢; tauto
      · intro k hk; simp only [Finset.mem_insert, Finset.mem_singleton] at hk ⊢; tauto
    · rw [← mulVec_mulVec, hc]

/-- **A unitary whose column `a` is `c·eₐ` has row `a` equal to `c·eₐ`**, and `|c| = 1`. -/
theorem row_of_column {W : Matrix ι ι ℂ} (hW : W ∈ Matrix.unitaryGroup ι ℂ) (a : ι) (c : ℂ)
    (hcol : ∀ k, W k a = (Pi.single a c : ι → ℂ) k) : (∀ l, l ≠ a → W a l = 0) ∧ star c * c = 1 := by
  have hsW : star W * W = 1 := Matrix.mem_unitaryGroup_iff'.mp hW
  have key : ∀ l, (star W * W) a l = star c * W a l := by
    intro l
    rw [mul_apply, Finset.sum_eq_single a]
    · rw [Matrix.star_apply, hcol a]; simp
    · intro k _ hk; rw [Matrix.star_apply, hcol k, Pi.single_apply, if_neg hk]; simp
    · simp
  have hcc : star c * c = 1 := by
    have := key a; rw [hsW, hcol a] at this; simpa using this.symm
  refine ⟨fun l hl => ?_, hcc⟩
  have h := key l
  rw [hsW, Matrix.one_apply, if_neg (Ne.symm hl)] at h
  have hc0 : star c ≠ 0 := by intro h0; rw [h0, zero_mul] at hcc; exact zero_ne_one hcc
  exact (mul_eq_zero.mp h.symm).resolve_left hc0

/-! ## The decomposition -/

/-- The phase `diag(1, …, w, …, 1)` at coordinate `a`. -/
def phaseAt (a : ι) (w : ℂ) : Matrix ι ι ℂ := Matrix.diagonal (Function.update (fun _ => 1) a w)

theorem phaseAt_twoLevel (a : ι) (w : ℂ) (hw : w * star w = 1) : TwoLevel (phaseAt a w) := by
  refine ⟨?_, a, a, ?_⟩
  · rw [Matrix.mem_unitaryGroup_iff, phaseAt, Matrix.star_eq_conjTranspose,
      Matrix.diagonal_conjTranspose, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1; funext k
    by_cases hk : k = a
    · subst hk; simpa using hw
    · simp [Function.update_of_ne hk]
  · intro k l h
    simp only [Finset.mem_insert, Finset.mem_singleton, or_self] at h
    rw [phaseAt, Matrix.diagonal_apply, Matrix.one_apply]
    rcases h with hk | hl
    · simp [Function.update_of_ne hk]
    · by_cases hkl : k = l
      · subst hkl; simp [Function.update_of_ne hl]
      · simp [hkl]

/-- **Induction on the support.** A unitary supported on `S` is a product of two-level
unitaries. -/
theorem supported_mem_closure (S : Finset ι) :
    ∀ U : Matrix ι ι ℂ, U ∈ Matrix.unitaryGroup ι ℂ → SupportedOn S U →
      U ∈ twoLevelClosure ι := by
  induction S using Finset.induction_on with
  | empty =>
    intro U _ hUs
    rw [eq_one_of_supportedOn_empty hUs]; exact Submonoid.one_mem _
  | @insert a S' haS' ih =>
    intro U hU hUs
    have hv : ∀ k, k ∉ insert a S' → (fun m => U m a) k = 0 := by
      intro k hk
      have hka : k ≠ a := fun h => hk (by simp [h])
      simp only; rw [hUs k a (Or.inl hk), Matrix.one_apply, if_neg hka]
    obtain ⟨g, hg, hgs, c, hc⟩ := clear_column a S' haS' (fun m => U m a) hv
    set W := g * U with hW_def
    have hWu : W ∈ Matrix.unitaryGroup ι ℂ := Submonoid.mul_mem _ (mem_unitary_of_mem hg) hU
    have hWs : SupportedOn (insert a S') W := hgs.mul hUs
    have hcol : ∀ k, W k a = (Pi.single a c : ι → ℂ) k := by
      intro k
      have := congrFun hc k
      rw [← this]; simp [W, mul_apply, mulVec, dotProduct]
    obtain ⟨hrow, hcc⟩ := row_of_column hWu a c hcol
    have hP : TwoLevel (phaseAt a (star c)) := phaseAt_twoLevel a (star c) (by rw [star_star]; exact hcc)
    have hPg : phaseAt a (star c) * g ∈ twoLevelClosure ι :=
      Submonoid.mul_mem _ (twoLevel_mem hP) hg
    set W' := phaseAt a (star c) * W with hW'_def
    have hW'u : W' ∈ Matrix.unitaryGroup ι ℂ := Submonoid.mul_mem _ hP.1 hWu
    have hPs : SupportedOn (insert a S') (phaseAt a (star c)) := by
      obtain ⟨_, i, j, hs⟩ := hP
      intro k l h
      rw [phaseAt, Matrix.diagonal_apply, Matrix.one_apply]
      have hne : ∀ m, m ∉ insert a S' → m ≠ a := fun m hm h => hm (by simp [h])
      rcases h with hk | hl
      · simp [Function.update_of_ne (hne k hk)]
      · by_cases hkl : k = l
        · subst hkl; simp [Function.update_of_ne (hne k hl)]
        · simp [hkl]
    have hW's : SupportedOn S' W' := by
      intro k l h
      by_cases hk : k ∈ insert a S'
      · by_cases hl : l ∈ insert a S'
        · rw [hW'_def, Matrix.mul_apply, Finset.sum_eq_single k]
          · have hka : k = a ∨ l = a := by
              simp only [Finset.mem_insert] at hk hl
              rcases h with h | h
              · exact Or.inl (hk.resolve_right h)
              · exact Or.inr (hl.resolve_right h)
            rw [phaseAt, Matrix.diagonal_apply_eq]
            rcases hka with rfl | rfl
            · by_cases hlk : l = k
              · subst hlk; rw [hcol, Pi.single_eq_same, Function.update_self, hcc,
                  Matrix.one_apply_eq]
              · rw [hrow l hlk, mul_zero, Matrix.one_apply, if_neg (Ne.symm hlk)]
            · by_cases hkl : k = l
              · subst hkl; rw [hcol, Pi.single_eq_same, Function.update_self, hcc,
                  Matrix.one_apply_eq]
              · rw [hcol, Pi.single_apply, if_neg hkl, mul_zero, Matrix.one_apply, if_neg hkl]
          · intro m _ hm; rw [phaseAt, Matrix.diagonal_apply_ne _ (Ne.symm hm), zero_mul]
          · simp
        · exact (hPs.mul hWs) k l (Or.inr hl)
      · exact (hPs.mul hWs) k l (Or.inl hk)
    have hW'mem := ih W' hW'u hW's
    have hU_eq : U = star (phaseAt a (star c) * g) * W' := by
      rw [hW'_def, hW_def, ← mul_assoc (phaseAt a (star c)) g U, ← mul_assoc]
      rw [Matrix.mem_unitaryGroup_iff'.mp (mem_unitary_of_mem hPg), one_mul]
    rw [hU_eq]
    exact Submonoid.mul_mem _ (star_mem_closure hPg) hW'mem

/-- **Every unitary is in the monoid generated by two-level unitaries.** -/
theorem unitary_mem_closure_twoLevel (U : Matrix ι ι ℂ) (hU : U ∈ Matrix.unitaryGroup ι ℂ) :
    U ∈ twoLevelClosure ι :=
  supported_mem_closure Finset.univ U hU (fun k l h => by simp at h)

/-- **Every unitary is a finite product of two-level unitaries.** -/
theorem unitary_eq_prod_twoLevel (U : Matrix ι ι ℂ) (hU : U ∈ Matrix.unitaryGroup ι ℂ) :
    ∃ l : List (Matrix ι ι ℂ), (∀ V ∈ l, TwoLevel V) ∧ l.prod = U :=
  Submonoid.exists_list_of_mem_closure (unitary_mem_closure_twoLevel U hU)

end QLF.TwoLevelUnitary
